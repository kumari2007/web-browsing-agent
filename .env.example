# ==============================================================================
# NEXUS — Autonomous Web Intelligence Agent Configuration
# ==============================================================================

# --- LLM Provider Selection ---
# Options: ollama | openai | groq | openrouter | gemini | deterministic
LLM_PROVIDER=ollama

# --- Local Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90

# --- Cloud LLM Configuration (OpenAI / Groq / OpenRouter / Gemini) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings & RAG Vector Database ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=data/vector_store
SQLITE_DB_PATH=data/agent_memory.db
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RELEVANCE_THRESHOLD=0.30

# --- Server & Networking ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# --- Browser Automation (Playwright) ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
BROWSER_SLOW_MO_MS=50
MAX_SEARCH_RESULTS=5
DEFAULT_INSPECT_PAGES=3
MAX_TASK_STEPS=15
MAX_RETRY_ATTEMPTS=3
MAX_NAVIGATION_DEPTH=3
EXECUTION_TIMEOUT_SECONDS=180

# --- Safety & Policy Enforcement ---
DEFAULT_SEARCH_PROVIDER=duckduckgo
BLOCK_PRIVATE_IPS=true
REQUIRE_HUMAN_CONFIRMATION_ON_HIGH_RISK=true
READ_ONLY_MODE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/agent.log
